Options -Indexes
RewriteEngine On

# One host for search engines: http and www both end on https://pixelgesellen.de in a single redirect
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /impressum/ -> /impressum, also /produkte/, which is a folder and a page
RewriteCond %{REQUEST_FILENAME} !-d [OR]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [L,R=301]

# Prerendered pages: /impressum is served from impressum.html, /produkte/weingut from produkte/weingut.html.
# This comes before the folder check, so /produkte is the page and not the folder of its subpages.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a real 404 with the prerendered error page, not the home page with status 200
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"

  # Vite puts a content hash into every built file name, so these never change under the same name
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
